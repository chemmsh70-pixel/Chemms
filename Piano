local function btn(text, y, color)
	local b = mk("TextButton", {
		Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, y),
		Text = text, BackgroundColor3 = color, TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.Gotham, TextSize = 13,
	}, main)
	mk("UICorner", {}, b)
	return b
end

local ON, OFF = Color3.fromRGB(40, 140, 80), Color3.fromRGB(90, 90, 100)
local function toggle(label, key, y, onChange)
	local b = btn("", y, ON)
	local function paint()
		b.Text = label .. ": " .. (S[key] and "BẬT" or "TẮT")
		b.BackgroundColor3 = S[key] and ON or OFF
	end
	paint()
	b.MouseButton1Click:Connect(function()
		S[key] = not S[key]
		paint()
		if onChange then onChange(S[key]) end
	end)
	return paint
end

