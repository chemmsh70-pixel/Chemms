end)

local function calculateLiveSpeed(relativeTime)
    for i = 1, #SpeedCurve - 1 do
        local p1, p2 = SpeedCurve[i], SpeedCurve[i+1]
        if relativeTime >= p1.t and relativeTime <= p2.t then
            local range = p2.t - p1.t
            if range <= 0 then return p1.s end
            return p1.s + (p2.s - p1.s) * ((relativeTime - p1.t) / range)
        end
    end
    return 1.0
end

