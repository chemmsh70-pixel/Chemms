local function playNextInSequence()
    if currentSeqIndex > #Sequence then
        sequencePlaying = false; StopAllBtn.Text = "⏹️ DỪNG TẤT CẢ (VỀ BÌNH THƯỜNG)"; return
    end
    local clip = Sequence[currentSeqIndex]
    local anim = Instance.new("Animation"); anim.AnimationId = "rbxassetid://" .. clip.id
    if currentTrack then currentTrack:Stop() end
    local char = Player.Character; local animator = char and char:FindFirstChild("Humanoid") and char.Humanoid:FindFirstChild("Animator")
    currentTrack = animator:LoadAnimation(anim); currentTrack:Play(); currentTrack:AdjustSpeed(0)
    
    task.spawn(function()
        local timeout = 0; while currentTrack.Length <= 0 and timeout < 30 do task.wait(0.1); timeout = timeout + 1 end
        originalMaxTime = currentTrack.Length
        startTime = clip.startTime; endTime = clip.endTime
        currentSpeedMode = clip.speedMode; baseSpeed = clip.baseSpeed
        SpeedCurve = HttpService:JSONDecode(HttpService:JSONEncode(clip.SpeedCurve)) -- Deep Copy
        isReversed = clip.isReversed
        playheadTime = isReversed and endTime or startTime
        currentTrack.TimePosition = playheadTime
        renderCurve(); updateTimelineUI(); updateDurationUI()
    end)
end

RunService.Heartbeat:Connect(function()
    if currentTrack and not draggingTime then
        if isPlaying and not sequencePlaying then
            playheadTime = currentTrack.TimePosition
            if not isReversed and playheadTime >= endTime then currentTrack.TimePosition = startTime
            elseif isReversed and playheadTime <= startTime then currentTrack.TimePosition = endTime end
            updateTimelineUI()
            local currentSpd = baseSpeed
            if currentSpeedMode == "Curve" and endTime > startTime then
                local relativeT = not isReversed and ((playheadTime - startTime) / (endTime - startTime)) or ((endTime - playheadTime) / (endTime - startTime))
                currentSpd = calculateLiveSpeed(relativeT)
            end
            currentTrack:AdjustSpeed(currentSpd * (isReversed and -1 or 1))
            
        elseif sequencePlaying then
            playheadTime = currentTrack.TimePosition
            local isFinished = false
            if not isReversed and playheadTime >= endTime then isFinished = true
            elseif isReversed and playheadTime <= startTime then isFinished = true end
            
            if isFinished then
                currentSeqIndex = currentSeqIndex + 1; playNextInSequence()
            else
                local currentSpd = baseSpeed
                if currentSpeedMode == "Curve" and endTime > startTime then
                    local relativeT = not isReversed and ((playheadTime - startTime) / (endTime - startTime)) or ((endTime - playheadTime) / (endTime - startTime))
                    currentSpd = calculateLiveSpeed(relativeT)
                end
                currentTrack:AdjustSpeed(currentSpd * (isReversed and -1 or 1))
                updateTimelineUI()
            end
        end
    end
end)

