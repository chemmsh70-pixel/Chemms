local function updateDurationUI()
    local baseDur = endTime - startTime
    local finalDur = calculateCurveDuration()
    DurationInfo.Text = string.format("Thời lượng: %.2fs ➔ %.2fs", baseDur, finalDur)
end

local function updateTimelineUI()
    local clipLength = endTime - startTime
    if clipLength <= 0 then return end
    local relativePos = playheadTime - startTime
    local percent = math.clamp(relativePos / clipLength, 0, 1)
    
    TimeKnob.Position = UDim2.new(percent, 0, 0.5, 0)
    TimeLabel.Text = string.format("Vị trí: %.2fs / %.2fs", relativePos, clipLength)
end

