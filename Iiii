-- 2. XỬ LÝ LOGIC UI

-- Cập nhật kích thước khi ông nhập số mới
SizeInput.FocusLost:Connect(function()
    local newSize = tonumber(SizeInput.Text)
    if newSize then -- Nếu nhập đúng là số
        _G.HeadSize = newSize
    else -- Nếu nhập bậy (chữ) thì trả về số hiện tại
        SizeInput.Text = tostring(_G.HeadSize)
    end
end)

-- Khôi phục kích thước đầu khi TẮT
local function RevertHitbox()
    for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("Head") then
            if not game:GetService("Players"):GetPlayerFromCharacter(v) then
                pcall(function()
                    v.Head.Size = Vector3.new(1.2, 1, 1) -- Đưa về size nhỏ gọn của game
                    v.Head.Transparency = 0 -- Cho hiện lại đầu bình thường
                    v.Head.CanCollide = true
                    v.Head.Massless = false
                end)
            end
        end
    end
end

-- Bấm nút BẬT/TẮT
ToggleBtn.MouseButton1Click:Connect(function()
    _G.HitboxStatus = not _G.HitboxStatus
    if _G.HitboxStatus then
        ToggleBtn.Text = "Đang: BẬT"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(75, 255, 75)
    else
        ToggleBtn.Text = "Đang: TẮT"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 75, 75)
        RevertHitbox() 
    end
end)

---

-- 3. VÒNG LẶP PHÓNG TO HITBOX CỦA NPC
task.spawn(function()
    while task.wait(0.5) do
        if _G.HitboxStatus then
            for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
                if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("Head") and v.Humanoid.Health > 0 then
                    -- Lọc lấy NPC
                    if not game:GetService("Players"):GetPlayerFromCharacter(v) then
                        pcall(function()
                            v.Head.Size = Vector3.new(_G.HeadSize, _G.HeadSize, _G.HeadSize)
                            
                            -- CHỈNH TÀNG HÌNH ĐỂ GIẢM LAG (Không render màu/vật liệu nữa)
                            v.Head.Transparency = 1 
                            
                            v.Head.CanCollide = false
                            v.Head.Massless = true
                        end)
                    end
                end
            end
        end
    end
end)
