-- === HÀM TÍNH TOÁN === --
local function calculateCurveDuration()
    local baseDur = endTime - startTime
    if baseDur <= 0 then return 0 end
    if currentSpeedMode == "Fixed" then return baseDur / baseSpeed end
    
    local totalTime = 0
    for i = 1, #SpeedCurve - 1 do
        local p1, p2 = SpeedCurve[i], SpeedCurve[i+1]
        local dt = (p2.t - p1.t) * baseDur
        local s1, s2 = p1.s, p2.s
        
        if math.abs(s1 - s2) < 0.01 then
            totalTime = totalTime + (dt / s1)
        else
            totalTime = totalTime + (dt / (s2 - s1)) * math.log(s2 / s1)
        end
    end
    return totalTime
end

