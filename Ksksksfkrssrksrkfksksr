    local anim = Instance.new("Animation"); anim.AnimationId = "rbxassetid://" .. id
    currentTrack = animator:LoadAnimation(anim)
    currentTrack.Looped = false 
    currentTrack:Play(); currentTrack:AdjustSpeed(0)
    
    local timeout = 0; while currentTrack.Length <= 0 and timeout < 30 do task.wait(0.1); timeout = timeout + 1 end
    if currentTrack.Length > 0 then
        originalMaxTime = currentTrack.Length; startTime = 0; endTime = originalMaxTime; playheadTime = 0
        isPlaying = false; PlayPauseBtn.Text = "▶️ PLAY"; PlayPauseBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        updateTimelineUI(); updateDurationUI()
    end
end)

