-- LOGIC KẾT NỐI CHUỖI & XUẤT CODE ĐÃ FIX
local function playNextInSequence()
    if currentSeqIndex > #Sequence then
        sequencePlaying = false
        StopAllBtn.Text = "⏹️ DỪNG TẤT CẢ (VỀ BÌNH THƯỜNG)"
        PlaySeqBtn.Text = "🎬 CHẠY TOÀN BỘ"
        if currentTrack then currentTrack:Stop() end
        return
    end
    
    local clip = Sequence[currentSeqIndex]
    local anim = Instance.new("Animation"); anim.AnimationId = "rbxassetid://" .. clip.id
    if currentTrack then currentTrack:Stop() end
    local char = Player.Character; local animator = char and char:FindFirstChild("Humanoid") and char.Humanoid:FindFirstChild("Animator")
    currentTrack = animator:LoadAnimation(anim)
    currentTrack.Looped = false 
    currentTrack:Play(); currentTrack:AdjustSpeed(0)
    
    task.spawn(function()
        local timeout = 0; while currentTrack.Length <= 0 and timeout < 30 do task.wait(0.1); timeout = timeout + 1 end
        originalMaxTime = currentTrack.Length
        startTime = clip.startTime; endTime = clip.endTime
        currentSpeedMode = clip.speedMode; baseSpeed = clip.baseSpeed
        SpeedCurve = HttpService:JSONDecode(HttpService:JSONEncode(clip.SpeedCurve))
        isReversed = clip.isReversed
        playheadTime = isReversed and endTime or startTime
        currentTrack.TimePosition = playheadTime
        updateTimelineUI(); updateDurationUI()
    end)
end

RunService.Heartbeat:Connect(function()
    if currentTrack then
        if isPlaying and not sequencePlaying then
            playheadTime = currentTrack.TimePosition
            if not isReversed and playheadTime >= endTime then currentTrack.TimePosition = startTime
            elseif isReversed and playheadTime <= startTime then currentTrack.TimePosition = endTime end
            updateTimelineUI()
            local currentSpd = baseSpeed
            currentTrack:AdjustSpeed(currentSpd * (isReversed and -1 or 1))
            
        elseif sequencePlaying then
            playheadTime = currentTrack.TimePosition
            local isFinished = false
            if not isReversed and playheadTime >= endTime then isFinished = true
            elseif isReversed and playheadTime <= startTime then isFinished = true end
            
            if isFinished then
                currentSeqIndex = currentSeqIndex + 1; playNextInSequence()
            else
                currentTrack:AdjustSpeed(baseSpeed * (isReversed and -1 or 1))
                updateTimelineUI()
            end
        end
    end
end)

-- LOGIC BLOCKER (CHẶN ANIMATION MỚI THÊM)
local function startBlockingProcess(char)
    if not char then return end
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    local animator = humanoid:WaitForChild("Animator", 5)
    if not animator then return end

    -- Dừng tất cả những cái đang chạy nếu có ID trùng
    for _, track in pairs(animator:GetPlayingAnimationTracks()) do
        if track.Animation and string.find(track.Animation.AnimationId, blockedAnimId) then
            track:AdjustWeight(0)
            track:Stop(0)
        end
    end

    -- Canh chừng những cái sắp chạy
    blockConnection = animator.AnimationPlayed:Connect(function(track)
        if not isBlocking then return end
        if track.Animation and string.find(track.Animation.AnimationId, blockedAnimId) then
            track:AdjustWeight(0)
            track:Stop(0) -- Dừng ngay lập tức
        end
    end)
end

ToggleBlockBtn.MouseButton1Click:Connect(function()
    if isBlocking then
        -- Đang bật -> Tắt
        isBlocking = false
        ToggleBlockBtn.Text = "🛡️ BẬT CHẶN ANIM"
        ToggleBlockBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        BlockIdBox.TextEditable = true
        if blockConnection then blockConnection:Disconnect(); blockConnection = nil end
        if charAddedConnection then charAddedConnection:Disconnect(); charAddedConnection = nil end
    else
        -- Đang tắt -> Bật
        local inputId = string.match(BlockIdBox.Text, "%d+")
        if not inputId then 
            BlockIdBox.Text = "Chưa nhập ID!"
            task.delay(1, function() BlockIdBox.Text = "" end)
            return 
        end
        
        blockedAnimId = inputId
        isBlocking = true
        ToggleBlockBtn.Text = "🔴 ĐANG CHẶN ID: " .. blockedAnimId
        ToggleBlockBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        BlockIdBox.TextEditable = false
        
        -- Kích hoạt chặn ngay lập tức
        startBlockingProcess(Player.Character)
        
        -- Nếu nhân vật chết/reset, tự động gắn lại bộ chặn
        charAddedConnection = Player.CharacterAdded:Connect(function(newChar)
            if isBlocking then
                startBlockingProcess(newChar)
            end
        end)
    end
end)

