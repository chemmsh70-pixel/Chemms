-- === HỆ THỐNG LOGIC ĐỒ THỊ (SPEED CURVE) === --
local curveLines = {}
local curveNodes = {}
local isDraggingNode = false
local activeNodeIndex = 0

-- Chuyển đổi Tốc độ sang Y (0.1x -> 10x)
local function speedToY(s)
    -- Giới hạn: 0.1x (Y=0.95), 1x (Y=0.9), 10x (Y=0.1)
    if s <= 1 then
        return 0.9 - (s - 0.1) * (0.05 / 0.9)
    else
        return 0.9 - (s - 1) * (0.8 / 9)
    end
end

-- Chuyển đổi Y sang Tốc độ
local function yToSpeed(y)
    y = math.clamp(y, 0.1, 0.95)
    if y >= 0.9 then
        return 0.1 + (0.9 - y) * (0.9 / 0.05)
    else
        return 1 + (0.9 - y) * (9 / 0.8)
    end
end

-- Sắp xếp lại Curve theo thời gian
local function sortCurve()
    table.sort(SpeedCurve, function(a, b) return a.t < b.t end)
end

-- Vẽ các đường nối và cục Node
local function renderCurve()
    sortCurve()
    for _, obj in pairs(curveLines) do obj:Destroy() end
    for _, obj in pairs(curveNodes) do obj:Destroy() end
    curveLines = {}
    curveNodes = {}

    local width = CurveBoard.AbsoluteSize.X
    local height = CurveBoard.AbsoluteSize.Y
    if width == 0 then return end

    -- Vẽ Line nối
    for i = 1, #SpeedCurve - 1 do
        local p1 = SpeedCurve[i]
        local p2 = SpeedCurve[i+1]
        
        local x1, y1 = p1.t * width, speedToY(p1.s) * height
        local x2, y2 = p2.t * width, speedToY(p2.s) * height
        
        local line = Instance.new("Frame")
        line.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
        line.BorderSizePixel = 0
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        
        local length = math.sqrt((x2-x1)^2 + (y2-y1)^2)
        local angle = math.deg(math.atan2(y2-y1, x2-x1))
        
        line.Size = UDim2.new(0, length, 0, 2)
        line.Position = UDim2.new(0, (x1+x2)/2, 0, (y1+y2)/2)
        line.Rotation = angle
        line.Parent = CurveBoard
        table.insert(curveLines, line)
    end

    -- Vẽ Cục Node (Nhịp)
    for i, p in ipairs(SpeedCurve) do
        local node = Instance.new("TextButton")
        node.Size = UDim2.new(0, 12, 0, 12)
        node.AnchorPoint = Vector2.new(0.5, 0.5)
        node.Position = UDim2.new(p.t, 0, speedToY(p.s), 0)
        
        if i == selectedPointIndex then
            node.BackgroundColor3 = Color3.fromRGB(255, 50, 50) -- Đỏ nếu đang chọn
            node.Size = UDim2.new(0, 16, 0, 16)
        else
            node.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        end
        node.Text = ""
        Instance.new("UICorner", node).CornerRadius = UDim.new(1, 0)
        node.Parent = CurveBoard
        
        -- Logic Kéo/Thả điểm Node
        node.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                isDraggingNode = true
                activeNodeIndex = i
                selectedPointIndex = i
                renderCurve()
            end
        end)
        
        table.insert(curveNodes, node)
    end
end

UserInputService.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        isDraggingNode = false
    end
end)

UserInputService.InputChanged:Connect(function(inp)
    if isDraggingNode and activeNodeIndex > 0 then
        local localX = (inp.Position.X - CurveBoard.AbsolutePosition.X) / CurveBoard.AbsoluteSize.X
        local localY = (inp.Position.Y - CurveBoard.AbsolutePosition.Y) / CurveBoard.AbsoluteSize.Y
        
        -- Cập nhật Y (Tốc độ)
        SpeedCurve[activeNodeIndex].s = yToSpeed(localY)
        
        -- Cập nhật X (Thời gian), không cho điểm trôi qua điểm kề cận
        if activeNodeIndex > 1 and activeNodeIndex < #SpeedCurve then
            local prevT = SpeedCurve[activeNodeIndex-1].t + 0.05
            local nextT = SpeedCurve[activeNodeIndex+1].t - 0.05
            SpeedCurve[activeNodeIndex].t = math.clamp(localX, prevT, nextT)
        end
        
        renderCurve()
    end
end)

-- Nút Thêm Nhịp
AddBeatBtn.MouseButton1Click:Connect(function()
    if endTime <= startTime then return end
    
    local relativeTime = 0
    if not isReversed then
        relativeTime = (playheadTime - startTime) / (endTime - startTime)
    else
        relativeTime = (endTime - playheadTime) / (endTime - startTime)
    end
    relativeTime = math.clamp(relativeTime, 0, 1)
    
    table.insert(SpeedCurve, {t = relativeTime, s = 1.0})
    sortCurve()
    renderCurve()
end)

-- Nút Xóa Nhịp
DelBeatBtn.MouseButton1Click:Connect(function()
    if #SpeedCurve > 2 and selectedPointIndex > 1 and selectedPointIndex < #SpeedCurve then
        table.remove(SpeedCurve, selectedPointIndex)
        selectedPointIndex = 1
        renderCurve()
    end
end)


-- Tính toán Tốc độ mượt mà dựa trên 2 điểm Keyframe gần nhất
local function calculateCurveSpeed(relativeTime)
    for i = 1, #SpeedCurve - 1 do
        local p1 = SpeedCurve[i]
        local p2 = SpeedCurve[i+1]
        
        if relativeTime >= p1.t and relativeTime <= p2.t then
            local range = p2.t - p1.t
            if range <= 0 then return p1.s end
            local progress = (relativeTime - p1.t) / range
            -- Nội suy tuyến tính (Đường thẳng nối 2 điểm)
            return p1.s + (p2.s - p1.s) * progress
        end
    end
    return 1.0
end


-- === TIMELINE VÀ PLAYHEAD === --
local function drawActiveRegion()
    if maxTime > 0 then
        local pStart = startTime / maxTime
        local pEnd = endTime / maxTime
        ActiveRegion.Position = UDim2.new(pStart, 0, 0, 0)
        ActiveRegion.Size = UDim2.new(pEnd - pStart, 0, 1, 0)
    end
end

LoadBtn.MouseButton1Click:Connect(function()
    local id = string.match(IDInput.Text, "%d+")
    if not id then return end
    currentId = id

    local char = Player.Character
    if not char then return end
    local animator = char:FindFirstChild("Humanoid") and char.Humanoid:FindFirstChild("Animator")
    if not animator then return end

    if currentTrack then currentTrack:Stop() end
    
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. id
    currentTrack = animator:LoadAnimation(anim)
    currentTrack:Play()
    currentTrack:AdjustSpeed(0)
    
    local timeout = 0
    while currentTrack.Length <= 0 and timeout < 30 do task.wait(0.1); timeout = timeout + 1 end
    
    if currentTrack.Length > 0 then
        maxTime = currentTrack.Length
        startTime = 0
        endTime = maxTime
        playheadTime = 0
        SpeedCurve = {{t=0, s=1}, {t=1, s=1}} -- Reset Curve
        renderCurve()
        isPlaying = false
        PlayPauseBtn.Text = "▶️ PLAY"
        drawActiveRegion()
    end
end)

-- UPDATE TIMELINE & ÁP DỤNG SPEED CURVE LIÊN TỤC
RunService.Heartbeat:Connect(function()
    if currentTrack and isPlaying and not sequencePlaying then
        playheadTime = currentTrack.TimePosition
        
        if not isReversed and playheadTime >= endTime then
            currentTrack.TimePosition = startTime
        elseif isReversed and playheadTime <= startTime then
            currentTrack.TimePosition = endTime
        end
        
        local percent = math.clamp(playheadTime / maxTime, 0, 1)
        TimeKnob.Position = UDim2.new(percent, 0, 0.5, 0)
        TimeLabel.Text = string.format("Thời gian: %.2fs / %.2fs", playheadTime, maxTime)
        
        -- Tính toán tốc độ hiện tại từ Graph
        local relativeTim = 0
        if endTime > startTime then
            if not isReversed then
                relativeTime = (playheadTime - startTime) / (endTime - startTime)
            else
                relativeTime = (endTime - playheadTime) / (endTime - startTime)
            end
        end
        
        local currentSpd = calculateCurveSpeed(relativeTime)
        LiveSpdLabel.Text = string.format("Tốc độ hiện tại: %.1fx", currentSpd)
        currentTrack:AdjustSpeed(currentSpd * (isReversed and -1 or 1))
    end
end)

