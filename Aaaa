-- ==========================================
-- NÚT USE (TO 5%, MÀU GALAXY, CÓ THỂ KÉO)
-- ==========================================
local UseBtn = Instance.new("TextButton", ScreenGui)
UseBtn.Size = UDim2.new(0.05, 0, 0.05, 0) -- Thu nhỏ thành 5%
UseBtn.SizeConstraint = Enum.SizeConstraint.RelativeXX
UseBtn.Position = UDim2.new(0.85, 0, 0.75, 0)
UseBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- Để màu trắng để UIGradient hoạt động chuẩn
UseBtn.Text = "USE"
UseBtn.Font = Enum.Font.GothamBlack
UseBtn.TextSize = 14 -- Chỉnh cỡ chữ cho vừa với nút 5%
UseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

local UseBtnCorner = Instance.new("UICorner", UseBtn)
UseBtnCorner.CornerRadius = UDim.new(1, 0)

-- MÀU GALAXY CHO NÚT USE ĐỒNG BỘ VỚI MENU
local UseGradient = Instance.new("UIGradient", UseBtn)
UseGradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 0, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 20, 50)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 0, 20))
})

-- Logic kéo thả mượt cho nút USE
local draggingUse, dragUseInput, dragUseStart, useStartPos
UseBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingUse = true
		dragUseStart = input.Position
		useStartPos = UseBtn.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then draggingUse = false end
		end)
	end
end)
UseBtn.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragUseInput = input
	end
end)
UIS.InputChanged:Connect(function(input)
	if input == dragUseInput and draggingUse then
		local delta = input.Position - dragUseStart
		UseBtn.Position = UDim2.new(useStartPos.X.Scale, useStartPos.X.Offset + delta.X, useStartPos.Y.Scale, useStartPos.Y.Offset + delta.Y)
	end
end)

-- ==========================================
-- LOGIC HOẠT ĐỘNG
-- ==========================================
local SelectedTools = {}
local Backpack = Player:WaitForChild("Backpack")

local function RefreshList()
	for _, child in pairs(Scroll:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	
	for _, tool in pairs(Backpack:GetChildren()) do
		if tool:IsA("Tool") then
			local ToolFrame = Instance.new("Frame", Scroll)
			ToolFrame.BackgroundColor3 = SelectedTools[tool] and Color3.fromRGB(80, 255, 80) or Color3.fromRGB(50, 50, 50)
			ToolFrame.BackgroundTransparency = SelectedTools[tool] and 0.3 or 0.6
			Instance.new("UICorner", ToolFrame).CornerRadius = UDim.new(0, 8)

			local Icon = Instance.new("ImageLabel", ToolFrame)
			Icon.Size = UDim2.new(0, 35, 0, 35)
			Icon.Position = UDim2.new(0, 5, 0.5, -17.5)
			Icon.BackgroundTransparency = 1
			Icon.Image = tool.TextureId ~= "" and tool.TextureId or "rbxassetid://16608511202"

			local NameLabel = Instance.new("TextLabel", ToolFrame)
			NameLabel.Size = UDim2.new(1, -45, 1, 0)
			NameLabel.Position = UDim2.new(0, 45, 0, 0)
			NameLabel.BackgroundTransparency = 1
			NameLabel.Text = tool.Name
			NameLabel.TextColor3 = Color3.new(1, 1, 1)
			NameLabel.Font = Enum.Font.GothamSemibold
			NameLabel.TextSize = 12
			NameLabel.TextXAlignment = Enum.TextXAlignment.Left
			NameLabel.TextWrapped = true

			local ClickBtn = Instance.new("TextButton", ToolFrame)
			ClickBtn.Size = UDim2.new(1, 0, 1, 0)
			ClickBtn.BackgroundTransparency = 1
			ClickBtn.Text = ""

			ClickBtn.MouseButton1Click:Connect(function()
				if SelectedTools[tool] then
					SelectedTools[tool] = nil
				else
					SelectedTools[tool] = tool
				end
				RefreshList()
			end)
		end
	end
	Scroll.CanvasSize = UDim2.new(0, 0, 0, math.ceil(#Backpack:GetChildren() / 2) * 50)
end

-- LỆNH 1: NHẤN ✅ ĐỂ ĐEO VŨ KHÍ VÀO NGƯỜI (Giữ nguyên gốc của ông)
EquipBtn.MouseButton1Click:Connect(function()
	local Char = Player.Character or Player.CharacterAdded:Wait()
	local RightHand = Char:FindFirstChild("RightHand") or Char:FindFirstChild("Right Arm")
	if not RightHand then return end

	for tool, _ in pairs(SelectedTools) do
		if tool and tool.Parent == Backpack then
			tool.Parent = Char 
			local handle = tool:FindFirstChild("Handle")
			if handle then
				local weld = Instance.new("Weld", handle)
				weld.Name = "MultiEquipWeld"
				weld.Part0 = RightHand
				weld.Part1 = handle
				weld.C1 = tool.Grip:Inverse()
			end
		end
	end
	SelectedTools = {} 
	RefreshList()
end)

-- LỆNH 2: NHẤN USE ĐỂ RA CHIÊU / ĐÁNH VẬT PHẨM ĐANG CẦM (Đã nâng cấp để đánh mượt)
UseBtn.MouseButton1Click:Connect(function()
	local Char = Player.Character
	if not Char then return end
	
	-- Quét tất cả vật phẩm đang gắn trên nhân vật và kích hoạt chiêu thức
	for _, tool in pairs(Char:GetChildren()) do
		if tool:IsA("Tool") then
			task.spawn(function()
				tool:Activate() -- Lệnh này tương đương với click chuột trái để xả chiêu/đánh
				task.wait(0.1) -- Đợi 0.1 giây
				tool:Deactivate() -- Nhả chuột ra để vũ khí không bị kẹt, giúp lần bấm USE tiếp theo vẫn đánh được
			end)
		end
	end
end)

Backpack.ChildAdded:Connect(RefreshList)
Backpack.ChildRemoved:Connect(RefreshList)

Player.CharacterAdded:Connect(function()
	Backpack = Player:WaitForChild("Backpack")
	SelectedTools = {}
	Backpack.ChildAdded:Connect(RefreshList)
	Backpack.ChildRemoved:Connect(RefreshList)
	RefreshList()
end)

RefreshList()
