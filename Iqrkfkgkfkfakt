ResetCutBtn.MouseButton1Click:Connect(function()
    startTime = 0
    endTime = originalMaxTime
    playheadTime = 0
    updateTimelineUI()
    updateDurationUI()
end)


-- XỬ LÝ VÒNG LẶP VIDEO
RunService.Heartbeat:Connect(function()
    if currentTrack and isPlaying and not draggingTime and not sequencePlaying then
        playheadTime = currentTrack.TimePosition
        
        if not isReversed and playheadTime >= endTime then currentTrack.TimePosition = startTime
        elseif isReversed and playheadTime <= startTime then currentTrack.TimePosition = endTime end
        
        updateTimelineUI()
        
        -- Chạy Tốc độ
        local currentSpd = baseSpeed
        if currentSpeedMode == "Curve" and endTime > startTime then
            local relativeT = not isReversed and ((playheadTime - startTime) / (endTime - startTime)) or ((endTime - playheadTime) / (endTime - startTime))
            currentSpd = calculateLiveSpeed(relativeT)
        end
        currentTrack:AdjustSpeed(currentSpd * (isReversed and -1 or 1))
    end
end)

LoadBtn.MouseButton1Click:Connect(function()
    local id = string.match(IDInput.Text, "%d+")
    if not id then return end
    currentId = id
    local char = Player.Character
    local animator = char and char:FindFirstChild("Humanoid") and char.Humanoid:FindFirstChild("Animator")
    if not animator then return end

    if currentTrack then currentTrack:Stop() end
    local anim = Instance.new("Animation"); anim.AnimationId = "rbxassetid://" .. id
    currentTrack = animator:LoadAnimation(anim); currentTrack:Play(); currentTrack:AdjustSpeed(0)
    
    local timeout = 0; while currentTrack.Length <= 0 and timeout < 30 do task.wait(0.1); timeout = timeout + 1 end
    
    if currentTrack.Length > 0 then
        originalMaxTime = currentTrack.Length
        startTime = 0; endTime = originalMaxTime; playheadTime = 0
        SpeedCurve = {{t=0, s=1}, {t=1, s=1}}
        renderCurve()
        isPlaying = false
        PlayPauseBtn.Text = "▶️ PLAY"
        updateTimelineUI()
        updateDurationUI()
    end
end)

PlayPauseBtn.MouseButton1Click:Connect(function()
    if not currentTrack then return end
    isPlaying = not isPlaying
    if isPlaying then 
        PlayPauseBtn.Text = "⏸️ PAUSE"
        PlayPauseBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
        if not isReversed and playheadTime >= endTime then currentTrack.TimePosition = startTime end
    else 
        PlayPauseBtn.Text = "▶️ PLAY"
        PlayPauseBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        currentTrack:AdjustSpeed(0) 
    end
end)

ReverseBtn.MouseButton1Click:Connect(function()
    isReversed = not isReversed
    ReverseBtn.Text = isReversed and "⏪ TUA NGƯỢC: ON" or "⏪ TUA NGƯỢC: OFF"
end)

StopAllBtn.MouseButton1Click:Connect(function()
    isPlaying, sequencePlaying = false, false
    local char = Player.Character
    if char and char:FindFirstChild("Humanoid") then
        local animator = char.Humanoid:FindFirstChild("Animator")
        if animator then for _, track in pairs(animator:GetPlayingAnimationTracks()) do track:Stop() end end
    end
    PlayPauseBtn.Text = "▶️ PLAY"; PlayPauseBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
end)

renderCurve()
