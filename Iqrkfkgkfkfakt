        -- Dịch percent về đúng khung giờ đã bị cắt
        local clipLength = endTime - startTime
        playheadTime = startTime + (percent * clipLength)
        
        updateTimelineUI()
       if currentTrack then currentTrack.TimePosition = playheadTime end
    end
end)

