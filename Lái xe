--==================================================
-- GET VEHICLE SEAT
--==================================================

local function getVehicleSeat()

	local character =
		player.Character

	if not character then
		return nil
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return nil
	end

	local seat =
		humanoid.SeatPart

	if seat and seat:IsA("VehicleSeat") then
		return seat
	end

	return nil
end

--==================================================
-- CAR CONTROL + LEFT/RIGHT FIX
--==================================================

RunService.Heartbeat:Connect(function(dt)

	local seat =
		getVehicleSeat()

	if not seat then
		return
	end

	--================================================
	-- QUẸO
	--================================================

	local steer = 0

	-- ĐÃ ĐẢO CHIỀU CHO ĐÚNG:
	-- ← = LEFT
	-- → = RIGHT

	if _G.CarLeft and not _G.CarRight then

		steer = 1

	elseif _G.CarRight and not _G.CarLeft then

		steer = -1

	end

	-- VehicleSeat
	seat.SteerFloat = steer
	seat.Steer = steer

	--================================================
	-- TIẾN / LÙI
	--================================================

	local throttle = 0

	if _G.CarForward and not _G.CarBackward then

		throttle = 1

	elseif _G.CarBackward and not _G.CarForward then

		throttle = -1

	end

	seat.ThrottleFloat = throttle
	seat.Throttle = throttle

	--================================================
	-- BASIC VEHICLE SETTINGS
	--================================================

	seat.MaxSpeed = currentSpeed
	seat.Torque = 100000
	seat.TurnSpeed = turnPower

	--================================================
	-- ROOT PART
	--================================================

	local root =
		seat.AssemblyRootPart or seat

	--================================================
	-- VẬN TỐC
	--================================================

	local velocity =
		root.AssemblyLinearVelocity

	local horizontalVelocity =
		Vector3.new(
			velocity.X,
			0,
			velocity.Z
		)

	local targetVelocity =
		horizontalVelocity

	local forwardDirection =
		seat.CFrame.LookVector

	--================================================
	-- TIẾN
	--================================================

	if _G.CarForward then

		local wanted =
			forwardDirection *
			currentSpeed

		targetVelocity =
			horizontalVelocity:Lerp(
				Vector3.new(
					wanted.X,
					0,
					wanted.Z
				),
				math.clamp(
					acceleration * dt,
					0,
					1
				)
			)

	--================================================
	-- LÙI
	--================================================

	elseif _G.CarBackward then

		local wanted =
			-forwardDirection *
			currentSpeed

		targetVelocity =
			horizontalVelocity:Lerp(
				Vector3.new(
					wanted.X,
					0,
					wanted.Z
				),
				math.clamp(
					reverseAcceleration * dt,
					0,
					1
				)
			)

	end

	--================================================
	-- GIỚI HẠN TỐC ĐỘ
	--================================================

	local flatSpeed =
		targetVelocity.Magnitude

	if flatSpeed > currentSpeed then

		targetVelocity =
			targetVelocity.Unit *
			currentSpeed

	end

	root.AssemblyLinearVelocity =
		Vector3.new(
			targetVelocity.X,
			velocity.Y,
			targetVelocity.Z
		)

	--================================================
	-- XOAY XE
	--================================================

	if steer ~= 0 then

		local speed =
			Vector3.new(
				velocity.X,
				0,
				velocity.Z
			).Magnitude

		local speedFactor =
			math.clamp(
				speed / math.max(currentSpeed,1),
				0.15,
				1
			)

		local actualTurnPower =
			math.max(
				minTurnPower,
				turnPower * speedFactor
			)

		local angular =
			root.AssemblyAngularVelocity

		-- Cùng chiều với steer mới
		root.AssemblyAngularVelocity =
			Vector3.new(
				angular.X,
				steer * actualTurnPower,
				angular.Z
			)

	else

		local angular =
			root.AssemblyAngularVelocity

		root.AssemblyAngularVelocity =
			Vector3.new(
				angular.X,
				angular.Y * 0.78,
				angular.Z
			)

	end

end)
