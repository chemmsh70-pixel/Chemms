--==================================================

local function saveSpeed()

	local number = tonumber(speedBox.Text)

	if number then

		number = math.floor(number)

		currentSpeed =
			math.clamp(
				number,
				minSpeed,
				maxSpeedLimit
			)
	end

	speedPanel.Visible = false

	pcall(function()
		speedBox:ReleaseFocus()
	end)

end

okButton.Activated:Connect(saveSpeed)

cancelButton.Activated:Connect(function()

	speedPanel.Visible = false

	pcall(function()
		speedBox:ReleaseFocus()
	end)

end)

speedBox.FocusLost:Connect(function(enterPressed)

	if enterPressed then
		saveSpeed()
	end

end)

