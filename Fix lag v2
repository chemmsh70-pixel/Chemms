local function placePanel()
	local scr, ps = gui.AbsoluteSize, panel.AbsoluteSize
	local hp, hs = holder.AbsolutePosition, holder.AbsoluteSize
	local x
	if hp.X + hs.X / 2 > scr.X / 2 then
		x = hp.X - ps.X - 8
	else
		x = hp.X + hs.X + 8
	end
	local y = hp.Y + hs.Y / 2 - ps.Y / 2
	x = math.clamp(x, 4, math.max(4, scr.X - ps.X - 4))
	y = math.clamp(y, 4, math.max(4, scr.Y - ps.Y - 4))
	panel.Position = UDim2.fromOffset(x, y)
end

local function setPanel(show)
	panel.Visible = show
	if show then placePanel() end
end

local function relayout()
	if panel.Visible then placePanel() end
end
