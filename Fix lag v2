end

local function wantRemove(cls)
	return (opt.effects and EMITTER[cls]) or (opt.details and (EMITTER[cls] or DETAIL[cls]))
end

-- gỡ ra khỏi game: keep = true thì nhớ chỗ cũ để trả lại khi tắt, không thì xoá hẳn
local function removeInst(d, keep)
	if keep then
		local p = d.Parent
		if p then
			removed[d] = p
			d.Parent = nil
		end
	else
		d:Destroy()
	end
end

local function stripPart(d, cls)
	if not origPart[d] then
		origPart[d] = {d.Material, d.Color, d.Reflectance, d.CastShadow}
		if cls == "MeshPart" then
			local tex = d.TextureID
			if tex ~= "" then origTex[d] = tex end
		elseif d:IsA("PartOperation") then
			origUnion[d] = d.UsePartColor
		end
	end
	d.Material = Enum.Material.SmoothPlastic
	d.Reflectance = 0
	d.CastShadow = false
	d.Color = GRAY
	if cls == "MeshPart" then
		d.TextureID = ""
	elseif d:IsA("PartOperation") then
		d.UsePartColor = true
	end
end

local function hidePart(d)
	if d == ground then return end
	mapHid[d] = true
	if d.LocalTransparencyModifier ~= 1 then d.LocalTransparencyModifier = 1 end
end

local function showPart(d)
	mapHid[d] = nil
	if d.LocalTransparencyModifier ~= 0 then d.LocalTransparencyModifier = 0 end
end

-- mảnh nhỏ mới sinh ra (đất đá bắn lên, mảnh vỡ...) thì xoá luôn
local function isDebris(d)
	if d.Transparency >= 0.95 then return false end -- vật vô hình (hitbox...) thì để yên
	local size = d.Size.Magnitude
	if size <= 20 and (not d.CanCollide or not d.Anchored) then return true end
	if size > 60 then return false end
	local p = d.Parent
	while p and p ~= workspace do
		if hasWord(p.Name, FX_FOLDERS) then return true end
		p = p.Parent
	end
	return size <= 30 and hasWord(d.Name, FX_NAMES)
end

-- mảnh đất dưới chân luôn được giữ lại, đi tới đâu đổi theo tới đó
local function updateGround()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {char}
	params.RespectCanCollide = true
	local r = workspace:Raycast(root.Position, Vector3.new(0, -100, 0), params)
	local g = r and r.Instance
	if g and (g.ClassName == "Terrain" or inCharacter(g)) then g = nil end
	if g == ground then return end
	local old = ground
	ground = g
	if g then showPart(g) end
	if old and old.Parent and opt.map and not isUIPart(old) then hidePart(old) end
end

local function process(d, isNew)
	local cls = d.ClassName
	local camera = workspace.CurrentCamera
	if camera and d:IsDescendantOf(camera) then return end -- không đụng gì thuộc camera

	if wantRemove(cls) then
		local p = d.Parent
		if not (DETAIL[cls] and p and p:IsA("BasePart") and isUIPart(p)) then
			-- đồ có sẵn (hoặc đồ của nhân vật) thì nhớ để trả lại, đồ sinh ra giữa trận thì xoá hẳn
			removeInst(d, (not isNew) or (DETAIL[cls] and inCharacter(d)))
			return
		end
	end
	if opt.effects and DISABLE[cls] then -- ánh sáng/blur/màu: chỉ tắt, không xoá (nhiều game dùng cho menu)
		if d.Enabled then
			fxOff[d] = true
			d.Enabled = false
		end
		return
	end

	if d:IsA("BasePart") then
		if cls == "Terrain" or isUIPart(d) then return end
		local char
		if opt.details then
			if isNew then
				char = inCharacter(d)
				if not char and isDebris(d) then
					removeInst(d, false)
					return
				end
			end
			stripPart(d, cls)
		end
		if opt.map then
			if char == nil then char = inCharacter(d) end
			if not char then hidePart(d) end
		end
		return
	end

	if opt.details and cls == "SpecialMesh" then
		if origMesh[d] == nil then origMesh[d] = d.TextureId end
		d.TextureId = ""
		return
	end
	if opt.map and MAP_OFF[cls] and not inCharacter(d) then
		if d.Enabled then
			mapOff[d] = true
			d.Enabled = false
		end
		return
	end
	if cls == "Animator" and (opt.anim or opt.alert) then
		hookAnimator(d)
		if opt.anim then
			for _, tr in d:GetPlayingAnimationTracks() do pcall(tr.Stop, tr, 0) end
		end
	elseif cls == "Humanoid" and opt.alert then
		watchChar(d.Parent)
	elseif cls == "LocalScript" and opt.anim and d.Name == "Animate" and not d.Disabled then
		d.Disabled = true
		animScripts[d] = true
	end
end

-- trả một thứ về như cũ (chỉ khi mục tương ứng đang tắt)
local function restoreInst(d)
	local changed = false
	if not opt.details then
		local o = origPart[d]
		if o then
			origPart[d] = nil
			d.Material = o[1]
			d.Color = o[2]
			d.Reflectance = o[3]
			d.CastShadow = o[4]
			changed = true
		end
		local tex = origTex[d]
		if tex ~= nil then origTex[d] = nil; d.TextureID = tex; changed = true end
		local upc = origUnion[d]
		if upc ~= nil then origUnion[d] = nil; d.UsePartColor = upc; changed = true end
		local mt = origMesh[d]
		if mt ~= nil then origMesh[d] = nil; d.TextureId = mt; changed = true end
	end
	if not opt.map then
		if mapHid[d] then mapHid[d] = nil; d.LocalTransparencyModifier = 0; changed = true end
		if mapOff[d] then mapOff[d] = nil; d.Enabled = true; changed = true end
	end
	if not opt.effects and fxOff[d] then
		fxOff[d] = nil
		d.Enabled = true
		changed = true
	end
	local parent = removed[d]
	if parent and not wantRemove(d.ClassName) then
		removed[d] = nil
		if parent:IsDescendantOf(game) then
			d.Parent = parent
			changed = true
		end
	end
	-- mục khác còn bật thì cho nó xử lý lại
	if changed and (opt.effects or opt.details or opt.map) then push(backlog, d) end
end

local function handleNew(d)
	if d.Parent then process(d, true) end
end

local function handleOld(d)
	if d.Parent then process(d, false) end
end

-- xử lý dần từng khung hình để không bị đứng máy
local function drain(q, handler, budget)
	local t0, n = os.clock(), 0
	while q.h <= q.t do
		local d = q[q.h]
		q[q.h] = nil
		q.h += 1
		if d then pcall(handler, d) end
		n += 1
		if n % 32 == 0 and os.clock() - t0 > budget then break end
	end
	if q.h > q.t then q.h, q.t = 1, 0 end
end

RunService.Heartbeat:Connect(function()
	if fresh.h <= fresh.t then drain(fresh, handleNew, 0.008) end
	if restoreQ.h <= restoreQ.t then drain(restoreQ, restoreInst, 0.003) end
	if backlog.h <= backlog.t then drain(backlog, handleOld, 0.003) end
end)

local function sweepAll()
	table.clear(backlog)
	backlog.h = 1
	local t = 0
	for _, d in workspace:GetDescendants() do
		t += 1
		backlog[t] = d
	end
	for _, d in Lighting:GetDescendants() do
		t += 1
		backlog[t] = d
	end
	backlog.t = t
end

local function enqueueRestore()
	table.clear(restoreQ)
	restoreQ.h = 1
	local t = 0
	for _, reg in {origPart, origTex, origUnion, origMesh, mapHid, mapOff, fxOff, removed} do
		for d in reg do
			t += 1
			restoreQ[t] = d
		end
	end
	restoreQ.t = t
end

local function onAdded(d)
	if opt.effects or opt.details or opt.anim or opt.alert or opt.map then push(fresh, d) end
end
workspace.DescendantAdded:Connect(onAdded)
Lighting.DescendantAdded:Connect(onAdded)

-- dọn những thứ đã bị game tự xoá hẳn (tránh tốn bộ nhớ)
local function touch(d) d.Parent = nil end
task.spawn(function()
	while true do
		task.wait(5)
		for d, parent in removed do
			if d.Parent ~= nil or not parent:IsDescendantOf(game) or not pcall(touch, d) then
				removed[d] = nil
			end
		end
	end
end)

-- chỉnh ánh sáng / nước / đất của cả map (mục 4), lưu lại để trả về
local WORLD_PROPS = {
	{Lighting, "GlobalShadows", false},
	{Lighting, "EnvironmentDiffuseScale", 0},
	{Lighting, "EnvironmentSpecularScale", 0},
	{workspace.Terrain, "WaterWaveSize", 0},
	{workspace.Terrain, "WaterWaveSpeed", 0},
	{workspace.Terrain, "WaterReflectance", 0},
}
local worldOrig = nil

local function stripWorld()
	local t = workspace.Terrain
	if not worldOrig then
		worldOrig = {mats = {}}
		for i, e in WORLD_PROPS do worldOrig[i] = get(e[1], e[2]) end
		for _, m in Enum.Material:GetEnumItems() do
			local ok, c = pcall(function() return t:GetMaterialColor(m) end)
			if ok then worldOrig.mats[m] = c end
		end
		local okq, q = pcall(function() return settings().Rendering.QualityLevel end)
		worldOrig.quality = okq and q or nil
	end
	for _, e in WORLD_PROPS do set(e[1], e[2], e[3]) end
	for m in worldOrig.mats do pcall(t.SetMaterialColor, t, m, GRAY) end
	pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
end

local function unstripWorld()
	if not worldOrig then return end
	local t = workspace.Terrain
	for i, e in WORLD_PROPS do
		if worldOrig[i] ~= nil then set(e[1], e[2], worldOrig[i]) end
	end
	for m, c in worldOrig.mats do pcall(t.SetMaterialColor, t, m, c) end
	if worldOrig.quality ~= nil then
		pcall(function() settings().Rendering.QualityLevel = worldOrig.quality end)
	end
	worldOrig = nil
end

local function restoreAnim() -- tắt mục 5
	for s in animScripts do
		if s.Parent then s.Disabled = false end
		animScripts[s] = nil
	end
	for a in animators do
		if a.Parent then
			pcall(function()
				for _, tr in a:GetPlayingAnimationTracks() do tr:AdjustWeight(1, 0) end
			end)
		end
	end
end

local function clearAlerts() -- tắt mục 6
	for _, hl in alertHL do hl.Parent = nil end
end

---------------------------------------------------------------- Bật / tắt từng mục
function setOption(key, value)
	opt[key] = value
	if key == "freeze" and value then selected = nil end -- bật lại thì tất cả đứng yên, kể cả người đã chọn
	if value then
		if key == "map" then updateGround() end
		if key == "details" then stripWorld() end
		if key == "effects" or key == "details" or key == "anim" or key == "map" then sweepAll() end
	else
		if key == "details" then unstripWorld() end
		if key == "map" then ground = nil end
		if key == "effects" or key == "details" or key == "map" then enqueueRestore() end
		if key == "anim" then restoreAnim() end
		if key == "alert" then clearAlerts() end
	end
	updateUI()
	refresh()
end

---------------------------------------------------------------- Kéo nút / chạm nút để mở menu
local dragging, dragInput, dragStart, startCenter, moved = false, nil, nil, nil, false

button.InputBegan:Connect(function(input)
	local t = input.UserInputType
	if dragging or (t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch) then return end
	dragging = true
	moved = false
	dragInput = input
	dragStart = input.Position
	startCenter = holder.AbsolutePosition + holder.AbsoluteSize / 2
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	if input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		if moved or delta.Magnitude > 12 then
			moved = true
			local scr, hs = gui.AbsoluteSize, holder.AbsoluteSize
			local cx = math.clamp(startCenter.X + delta.X, hs.X / 2, scr.X - hs.X / 2)
			local cy = math.clamp(startCenter.Y + delta.Y, hs.Y / 2, scr.Y - hs.Y / 2)
			holder.Position = UDim2.fromScale(cx / scr.X, cy / scr.Y)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if not dragging then return end
	local same = input == dragInput
		or (input.UserInputType == Enum.UserInputType.MouseButton1
			and dragInput.UserInputType == Enum.UserInputType.MouseButton1)
	if not same then return end
	dragging = false
	if not moved then setPanel(not panel.Visible) end -- chạm là mở/đóng menu luôn
end)

---------------------------------------------------------------- Chạm vào người chơi để chọn
-- tìm người chơi dưới ngón tay, bỏ qua vật vô hình hoặc đã bị ẩn
local function pickPlayer(x, y)
	local cam = workspace.CurrentCamera
	local ray = cam:ScreenPointToRay(x, y)
	local skip = {LocalPlayer.Character}
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	for _ = 1, 10 do
		params.FilterDescendantsInstances = skip
		local r = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
		if not r then return nil end
		local inst = r.Instance
		local tr = get(inst, "Transparency") or 0
		local lm = get(inst, "LocalTransparencyModifier") or 0
		if tr >= 0.95 or lm >= 0.95 then
			skip[#skip + 1] = inst
		else
			local m = inst
			while m and m ~= workspace do
				local plr = Players:GetPlayerFromCharacter(m)
				if plr then return plr end
				m = m.Parent
			end
			return nil
		end
	end
	return nil
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
	-- mục 1 bật: chọn người không bị đứng yên/ẩn
	local pickFreeze = opt.freeze
	-- mục 6 tắt (và đang mở menu hoặc mục 1 bật): chọn người để cảnh báo riêng
	local pickAlert = (not opt.alert) and (opt.freeze or panel.Visible)
	if not (pickFreeze or pickAlert) then return end

	local plr = pickPlayer(input.Position.X, input.Position.Y)
	if not plr or plr == LocalPlayer then return end

	local already = (pickFreeze and selected == plr) or (pickAlert and alertTarget == plr)
	if already then -- chạm lần nữa để bỏ chọn
		if pickFreeze and selected == plr then selected = nil end
		if pickAlert and alertTarget == plr then alertTarget = nil end
	else
		if pickFreeze then selected = plr end
		if pickAlert then alertTarget = plr end
	end
	updateUI()
	refresh()
end)

---------------------------------------------------------------- Vòng lặp cập nhật
local function pollAnimator(a)
	local owner = ownerOf(a)
	local watch = opt.alert and owner and owner ~= LocalPlayer and (not alertTarget or owner == alertTarget)
	if not (opt.anim or watch) then return end
	local cur = {}
	for _, tr in a:GetPlayingAnimationTracks() do
		cur[tr] = true
		startTrack(a, tr)
		if opt.anim and not pending[tr] then tr:Stop(0) end
	end
	local prev = lastPlaying[a]
	if prev then
		for tr in prev do
			if not cur[tr] then activeTracks[tr] = nil end
		end
	end
	lastPlaying[a] = cur
end

task.spawn(function()
	while true do
		if opt.anim or opt.alert then
			for a in animators do
				if a.Parent then pcall(pollAnimator, a) end
			end
		end
		if opt.map then pcall(updateGround) end
		task.wait(0.1)
	end
end)

task.spawn(function()
	while true do
		pcall(refresh)
		task.wait(0.5)
	end
end)

