local function push(q, d)
	q.t += 1
	q[q.t] = d
end

local function inCharacter(d)
	local m = d.Parent
	while m and m ~= workspace do
		if m:IsA("Model") and (m:FindFirstChildOfClass("Humanoid") or Players:FindFirstChild(m.Name)) then
			return true
		end
		m = m.Parent
	end
	return false
end

-- bảng/menu gắn trên part (SurfaceGui, BillboardGui...) thì không đụng vào
local function protectGui(g)
	if not (g:IsA("SurfaceGui") or g:IsA("BillboardGui")) then return end
	local a = g.Adornee
	if a and a:IsA("Attachment") then a = a.Parent end
	if a and a:IsA("BasePart") then uiParts[a] = true end
	if not guiHooked[g] then
		guiHooked[g] = true
		g:GetPropertyChangedSignal("Adornee"):Connect(function() protectGui(g) end)
	end
end
for _, g in PlayerGui:GetDescendants() do protectGui(g) end
PlayerGui.DescendantAdded:Connect(protectGui)

