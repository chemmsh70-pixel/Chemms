---------------------------------------------------------------- 6: Cảnh báo chiêu (thân đối thủ đỏ = chiêu, xanh = counter)
local function makeSound(id, fallbackSpeed)
	local s = Instance.new("Sound")
	s.Name = "LagMenuSound"
	s.Volume = SOUND_VOLUME
	s.SoundId = "rbxassetid://" .. id
	s.Parent = gui
	task.spawn(function()
		pcall(function() ContentProvider:PreloadAsync({s}) end)
		if not s.IsLoaded then -- ID không phát được thì dùng tạm tiếng bíp có sẵn
			s.SoundId = "rbxasset://sounds/electronicpingshort.wav"
			s.PlaybackSpeed = fallbackSpeed
		end
	end)
	return s
end
local sndDamage = makeSound(SOUND_DAMAGE, 0.7)
local sndCounter = makeSound(SOUND_COUNTER, 1.8)

local function alert(plr, kind)
	if not opt.alert then return end
	if alertTarget and plr ~= alertTarget then return end
	local char = plr.Character
	if not char then return end
	local now = os.clock()
	if kind ~= "counter" and alertLast[plr] and now - alertLast[plr] < 0.25 then return end
	alertLast[plr] = now
	local color = COLORS[kind]

	local hl = alertHL[plr]
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = HL_NAME
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillTransparency = 0.3
		alertHL[plr] = hl
	end
	hl.FillColor = color
	hl.OutlineColor = color
	hl.Parent = char

	if now - (lastSound[kind] or 0) > 0.12 then
		lastSound[kind] = now
		local snd = (kind == "counter") and sndCounter or sndDamage
		snd.TimePosition = 0
		snd:Play()
	end

	alertUntil[plr] = now + ALERT_TIME
	task.delay(ALERT_TIME, function()
		if os.clock() >= (alertUntil[plr] or 0) then hl.Parent = nil end
	end)
end

local function ownerOf(a)
	local hum = a.Parent
	local char = hum and hum.Parent
	if char and char:IsA("Model") then return Players:GetPlayerFromCharacter(char) end
	return nil
end

local function moveKind(track)
	local anim = track.Animation
	local id = anim and anim.AnimationId or ""
	local num = tonumber(string.match(id, "%d+"))
	local nm = track.Name .. " " .. (anim and anim.Name or "")
	if num and ignoreSet[num] then return nil, id, nm end
	if (num and counterSet[num]) or hasWord(nm, COUNTER_WORDS) then return "counter", id, nm end
	if not track.Looped and ACTION[track.Priority] then return "damage", id, nm end
	return nil, id, nm
end

local function classify(a, track)
	local plr = ownerOf(a)
	if not plr or plr == LocalPlayer then return end
	if alertTarget and plr ~= alertTarget then return end
	local myChar, char = LocalPlayer.Character, plr.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not myRoot or not root then return end
	if (root.Position - myRoot.Position).Magnitude > ALERT_RANGE then return end
	local t0 = os.clock()
	while track.Length == 0 and os.clock() - t0 < 0.4 do task.wait() end -- đợi animation load xong
	local kind, id, nm = moveKind(track)
	if PRINT_IDS then print("[Cảnh báo]", plr.Name, id, nm, track.Priority.Name, track.Looped) end
	if not kind then return end
	if kind == "damage" then
		if HIT_WAIT > 0 then task.wait(HIT_WAIT) end
		-- đối thủ vừa bị trúng đòn = animation giật người, không phải chiêu -> không báo
		if (lastHurt[plr] or -1000) >= t0 - HIT_BEFORE then return end
	end
	alert(plr, kind)
end

local function startTrack(a, track)
	if activeTracks[track] then return end
	activeTracks[track] = true
	if opt.anim then pcall(track.AdjustWeight, track, 0, 0) end -- ẩn dáng ngay lập tức
	if opt.alert then
		local plr = ownerOf(a)
		if plr and plr ~= LocalPlayer and (not alertTarget or plr == alertTarget) then
			pending[track] = true
			task.spawn(function()
				pcall(classify, a, track)
				pending[track] = nil
				if opt.anim then pcall(track.Stop, track, 0) end
			end)
		end
	end
end

local function hookAnimator(a)
	if animators[a] then return end
	animators[a] = true
	a.AnimationPlayed:Connect(function(track)
		if not (opt.anim or opt.alert) then return end
		startTrack(a, track)
		if opt.anim and not pending[track] then pcall(track.Stop, track, 0) end
	end)
end

local function watchChar(char)
	if not char then return end
	local plr = Players:GetPlayerFromCharacter(char)
	if not plr or plr == LocalPlayer then return end
	if alertTarget and plr ~= alertTarget then return end

	-- theo dõi máu: mất máu = vừa bị trúng đòn
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and not watchedHum[hum] then
		watchedHum[hum] = true
		local prev = hum.Health
		hum.HealthChanged:Connect(function(h)
			if h < prev then lastHurt[plr] = os.clock() end
			prev = h
		end)
	end

	if watchedChars[char] then return end
	watchedChars[char] = true
	local prevAttr = {}
	char.AttributeChanged:Connect(function(name)
		if not opt.alert then return end
		local v = char:GetAttribute(name)
		if hasWord(name, COUNTER_WORDS) then
			if v and v ~= 0 and v ~= "" then alert(plr, "counter") end
		elseif hasWord(name, HURT_WORDS) then
			if v and v ~= 0 and v ~= "" then lastHurt[plr] = os.clock() end
		elseif type(v) == "number" and hasWord(name, HEALTH_WORDS) then
			if prevAttr[name] and v < prevAttr[name] then lastHurt[plr] = os.clock() end
			prevAttr[name] = v
		end
	end)
	char.ChildAdded:Connect(function(c)
		if not opt.alert then return end
		if hasWord(c.Name, COUNTER_WORDS) then
			alert(plr, "counter")
		elseif hasWord(c.Name, HURT_WORDS) then
			lastHurt[plr] = os.clock()
		end
	end)
end

---------------------------------------------------------------- 1 & 2: Đứng yên / Ẩn người chơi
local function setFrozen(char, on)
	local root = char:FindFirstChild("HumanoidRootPart")
	if root then root.Anchored = on end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in animator:GetPlayingAnimationTracks() do
			track:AdjustSpeed(on and 0 or 1)
		end
	end
end

local function setHidden(char, on)
	local v = on and 1 or 0
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") then
			if d.LocalTransparencyModifier ~= v then d.LocalTransparencyModifier = v end
		elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
			if on then
				if d.Enabled then effectOff[d] = true; d.Enabled = false end
			elseif effectOff[d] then
				effectOff[d] = nil
				d.Enabled = true
			end
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		if on then
			if nameMode[hum] == nil then nameMode[hum] = hum.DisplayDistanceType end
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		elseif nameMode[hum] ~= nil then
			hum.DisplayDistanceType = nameMode[hum]
			nameMode[hum] = nil
		end
	end
end

local function refresh()
	if selected and not selected.Parent then selected = nil end
	if alertTarget and not alertTarget.Parent then
		alertTarget = nil -- người được chọn đã thoát game
		updateUI()
	end
	for _, plr in Players:GetPlayers() do
		local char = plr.Character
		if plr ~= LocalPlayer and char then
			local isSel = (plr == selected)
			local wantFreeze = opt.freeze and not isSel
			local wantHide = opt.hide and not isSel
			local st = state[char]
			if not st then
				st = {frozen = false, hidden = false}
				state[char] = st
			end
			if wantFreeze or st.frozen then pcall(setFrozen, char, wantFreeze) end
			if wantHide or st.hidden then pcall(setHidden, char, wantHide) end
			st.frozen = wantFreeze
			st.hidden = wantHide
			if opt.alert and (not alertTarget or plr == alertTarget) then
				watchChar(char)
				local hum = char:FindFirstChildOfClass("Humanoid")
				local an = hum and hum:FindFirstChildOfClass("Animator")
				if an then hookAnimator(an) end
			end
		end
	end
	local greenOn = selected and selected.Character and (opt.freeze or opt.hide)
	highlight.Parent = greenOn and selected.Character or nil
	local tchar = alertTarget and not opt.alert and alertTarget.Character
	if tchar and not (greenOn and alertTarget == selected) then
		targetHL.Parent = tchar
	else
		targetHL.Parent = nil
	end
end

