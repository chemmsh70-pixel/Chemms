-- TIMELINE HEARTBEAT LÕI
RunService.Heartbeat:Connect(function()
    if currentTrack and isPlaying and not draggingTime and not sequencePlaying then
        playheadTime = currentTrack.TimePosition
        
        if not isReversed and playheadTime >= endTime then currentTrack.TimePosition = startTime
        elseif isReversed and playheadTime <= startTime then currentTrack.TimePosition = endTime end
        
        local percent = math.clamp(playheadTime / maxTime, 0, 1)
        TimeKnob.Position = UDim2.new(percent, 0, 0.5, 0)
        TimeLabel.Text = string.format("Thời gian: %.2fs / %.2fs", playheadTime, maxTime)
        
        -- Cập nhật Tốc độ liên tục
        local currentSpd = baseSpeed
        if currentSpeedMode == "Curve" and endTime > startTime then
            local relativeT = not isReversed and ((playheadTime - startTime) / (endTime - startTime)) or ((endTime - playheadTime) / (endTime - startTime))
            currentSpd = calculateCurveSpeed(relativeT)
            LiveSpdLabel.Text = string.format("Tốc độ hiện tại: %.1fx", currentSpd)
        end
        currentTrack:AdjustSpeed(currentSpd * (isReversed and -1 or 1))
    end
end)

