-- 5. QUẢN LÝ CHUỖI & CODE (Hỗ trợ Lưu Đồ thị)
local function serializeCurve(curve)
    local str = ""
    for _, p in ipairs(curve) do str = str .. string.format("%.2f,%.1f|", p.t, p.s) end
    return str
end

local function parseCurve(str)
    local curve = {}
    for ptStr in string.gmatch(str, "([^|]+)") do
        local data = {}
        for part in string.gmatch(ptStr, "([^,]+)") do table.insert(data, part) end
        if #data == 2 then table.insert(curve, {t = tonumber(data[1]), s = tonumber(data[2])}) end
    end
    if #curve < 2 then curve = {{t=0, s=1}, {t=1, s=1}} end
    return curve
end

local function updateSeqLabel()
    if #Sequence == 0 then SeqLabel.Text = "Dự án trống"; return end
    SeqLabel.Text = "Có " .. #Sequence .. " đoạn. Bấm CHẠY để xem kết quả."
end

AddSeqBtn.MouseButton1Click:Connect(function()
    if currentId == "" then return end
    local curveCopy = {}
    for _, p in ipairs(SpeedCurve) do table.insert(curveCopy, {t=p.t, s=p.s}) end
    table.insert(Sequence, {
        id = currentId, st = startTime, en = endTime,
        rev = isReversed, mode = currentSpeedMode, sp = baseSpeed, curve = curveCopy
    })
    updateSeqLabel()
end)

UndoBtn.MouseButton1Click:Connect(function() if #Sequence > 0 then table.remove(Sequence, #Sequence); updateSeqLabel() end end)
ClearSeqBtn.MouseButton1Click:Connect(function() Sequence = {}; updateSeqLabel() end)

PlaySeqBtn.MouseButton1Click:Connect(function()
    if #Sequence == 0 or sequencePlaying then return end
    sequencePlaying = true
    local char = Player.Character
    local animator = char.Humanoid.Animator
    for _, track in pairs(animator:GetPlayingAnimationTracks()) do track:Stop() end

    task.spawn(function()
        for i, clip in ipairs(Sequence) do
            if not sequencePlaying then break end
            SeqLabel.Text = "Đang chạy đoạn [" .. i .. "/" .. #Sequence .. "]"
            
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://" .. clip.id
            local track = animator:LoadAnimation(anim)
            track:Play()
            track.TimePosition = clip.rev and clip.en or clip.st
            
            if clip.mode == "Curve" then
                -- Chạy đồ thị tốc độ
                local elapsed = 0
                while sequencePlaying do
                    local dt = RunService.Heartbeat:Wait()
                    elapsed = elapsed + dt
                    local currentT = track.TimePosition
                    if not clip.rev and currentT >= clip.en then break end
                    if clip.rev and currentT <= clip.st then break end
                    
                    local relativeT = 0
                    if clip.en > clip.st then
                        if not clip.rev then relativeT = (currentT - clip.st) / (clip.en - clip.st)
                        else relativeT = (clip.en - currentT) / (clip.en - clip.st) end
                    end
                    
                    local tempCurve = SpeedCurve
                    SpeedCurve = clip.curve 
                    local currentSpd = calculateCurveSpeed(relativeT)
                    SpeedCurve = tempCurve
                    track:AdjustSpeed(currentSpd * (clip.rev and -1 or 1))
                end
            else
                -- Chạy tốc độ cố định
                track:AdjustSpeed(clip.sp * (clip.rev and -1 or 1))
                local duration = (clip.en - clip.st) / (clip.sp == 0 and 1 or math.abs(clip.sp))
                task.wait(duration)
            end
            track:Stop()
        end
        sequencePlaying = false
        updateSeqLabel()
    end)
end)

SaveBtn.MouseButton1Click:Connect(function()
    if #Sequence == 0 then SaveCodeBox.Text = "Lỗi: Chưa có gì để lưu!"; return end
    local code = ""
    for _, clip in ipairs(Sequence) do
        local r = clip.rev and "1" or "0"
        local m = clip.mode == "Curve" and "1" or "0"
        local curveStr = serializeCurve(clip.curve)
        code = code .. string.format("%s:%.2f:%.2f:%s:%.1f:%s:%s;", clip.id, clip.st, clip.en, r, clip.sp, m, curveStr)
    end
    SaveCodeBox.Text = code
end)

LoadCodeBtn.MouseButton1Click:Connect(function()
    local code = SaveCodeBox.Text
    if code == "" then return end
    Sequence = {}
    for clipStr in string.gmatch(code, "([^;]+)") do
        local data = {}
        for part in string.gmatch(clipStr, "([^:]+)") do table.insert(data, part) end
        if #data == 7 then 
            table.insert(Sequence, {
                id = data[1], st = tonumber(data[2]), en = tonumber(data[3]), rev = (data[4] == "1"),
                sp = tonumber(data[5]), mode = (data[6] == "1" and "Curve" or "Fixed"), curve = parseCurve(data[7])
            })
        end
    end
    updateSeqLabel()
    SaveCodeBox.Text = "Đã Load thành công!"
    task.wait(2)
    SaveCodeBox.Text = ""
end)

